      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"normal_target\" TEXT NOT NULL, \"smaller_target\" TEXT NOT NULL, \"weekday_mask\" INTEGER NOT NULL, \"reminder_minutes\" INTEGER NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"start_date\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL);"
